# Copy to .env and override before `docker compose up`. Defaults below are for
# local development only and MUST be replaced in staging/production (Sealed
# Secrets / External Secrets in Kubernetes).
POSTGRES_DB=awap
POSTGRES_USER=awap
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=awapadmin
MINIO_ROOT_PASSWORD=change-me
GF_ADMIN_PASSWORD=change-me
VAULT_DEV_ROOT_TOKEN=change-me
# Outbound webhooks: sign every request and keep the allowlist fail-closed. The local stack only
# trusts the in-network fake webhook for private-range SSRF checks.
WEBHOOK_SECRET=change-me
WEBHOOK_ALLOWED_HOSTS=fake-webhook,localhost
WEBHOOK_SSRF_TRUSTED_HOSTS=fake-webhook

# AI Copilot (Phase 2). Replace the local token in any shared environment; the backend and AI layer
# must receive the same value. An empty token disables the internal tool API (fail closed).
AI_INTERNAL_TOKEN=local-dev-internal-token
AI_COPILOT_ENABLED=true
AI_COPILOT_TIMEOUT_MS=10000
AI_CONFIDENCE_THRESHOLD=0.7
AI_RATE_LIMIT_PER_MINUTE=60
AI_MODEL_CHEAP=local-heuristic
AI_MODEL_STANDARD=gpt-4o-mini
AI_MODEL_COMPLEX=gpt-4o
# Optional OpenAI-compatible endpoint used by the Copilot for free-form answers.
AI_COPILOT_LLM_BASE_URL=
AI_COPILOT_LLM_API_KEY=
