<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- PiiMaskingConsoleAppender masks emails, credentials and long tokens before the JSON
         encoder serialises the event (issue #191). JsonEncoder emits the MDC map, so every line
         carries correlationId and traceId. -->
    <appender name="JSON_CONSOLE" class="com.awap.common.logging.PiiMaskingConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.JsonEncoder"/>
    </appender>

    <!-- Issue #286: forwards redacted structured log events to the bounded OpenSearch shipper.
         The appender is inert until Spring installs a shipper and a tenant is present in the MDC. -->
    <appender name="OPENSEARCH_LOGS"
              class="com.awap.observability.log.infrastructure.LogbackOpenSearchAppender"/>

    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
        <appender-ref ref="OPENSEARCH_LOGS"/>
    </root>
</configuration>
